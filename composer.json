{
    "name": "knobik/laravel-horizon-job-output",
    "description": "Job Output for Laravel Horizon — give queued jobs the output API an Artisan command has, and watch it live on the job details page.",
    "type": "library",
    "keywords": [
        "laravel",
        "horizon",
        "queue",
        "jobs",
        "output",
        "console"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "knobik",
            "email": "knobiks@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/horizon": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Knobik\\HorizonJobOutput\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Knobik\\HorizonJobOutput\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Knobik\\HorizonJobOutput\\HorizonJobOutputServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
